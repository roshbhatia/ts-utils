{
  "name": "@roshbhatia/ts-utils",
  "version": "0.1.0",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect",
    "check": "bun run format:check && bun run typecheck && bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "nix:lock": "bunx bun2nix -o bun.nix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.3.13",
    "bun2nix": "2.1.2",
    "typescript": "5.9.3"
  }
}
