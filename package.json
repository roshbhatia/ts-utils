{
  "name": "@roshbhatia/ts-utils",
  "version": "0.6.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./template": "./src/template/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/config/index.ts src/template/index.ts src/ui/index.ts --root src --outdir dist --target bun --format esm --external effect --external handlebars",
    "check": "bun run format:check && bun run typecheck && bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "nix:lock": "bunx bun2nix -o bun.nix",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0-beta.83",
    "handlebars": "4.7.9"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "bun2nix": "2.1.2",
    "typescript": "5.8.2"
  }
}
